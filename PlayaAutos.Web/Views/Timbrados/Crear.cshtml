@model PlayaAutos.Web.Models.TimbradoViewModel
@{
    Layout = null;
    ViewData["Title"] = "Nuevo Timbrado";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PlayaAutos — Nuevo Timbrado</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="pa-app">

    @await Html.PartialAsync("_Sidebar")

    <div class="pa-content">

        <div class="pa-page-header d-flex align-items-center gap-3">
            <a href="/Timbrados" class="action-btn" style="flex-shrink:0;" title="Volver">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h4><i class="fa-solid fa-stamp me-2" style="color:var(--pa-accent);"></i>Nuevo Timbrado</h4>
                <p>Registre un timbrado emitido por la SET</p>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="pa-alert danger mb-3">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                <strong>Corrija los errores antes de continuar.</strong>
            </div>
        }

        <form asp-action="Crear" method="post" id="formCrear" novalidate>
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-lg-8">

                    <!-- Datos del timbrado -->
                    <div class="pa-card p-4 mb-3">
                        <div class="section-title mb-3">
                            <i class="fa-solid fa-stamp me-1" style="color:var(--pa-accent);"></i>
                            Datos del timbrado
                        </div>
                        <div class="row g-3">
                            <div class="col-md-12">
                                <label asp-for="NumeroTimbrado" class="pa-label">Número de timbrado *</label>
                                <input asp-for="NumeroTimbrado" class="pa-input font-monospace"
                                       placeholder="Ej: 12345678" autofocus
                                       style="font-family:monospace;font-size:1.1rem;letter-spacing:.05em;" />
                                <span asp-validation-for="NumeroTimbrado" class="val-msg"></span>
                                <small style="color:var(--pa-muted);font-size:0.75rem;">
                                    Número tal como figura en el documento emitido por la SET.
                                </small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FechaInicio" class="pa-label">Fecha de inicio *</label>
                                <input asp-for="FechaInicio" type="date" class="pa-input" />
                                <span asp-validation-for="FechaInicio" class="val-msg"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FechaVencimiento" class="pa-label">Fecha de vencimiento *</label>
                                <input asp-for="FechaVencimiento" type="date" class="pa-input"
                                       id="inputFechaVenc" />
                                <span asp-validation-for="FechaVencimiento" class="val-msg"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Rango de numeración -->
                    <div class="pa-card p-4">
                        <div class="section-title mb-3">
                            <i class="fa-solid fa-list-ol me-1" style="color:var(--pa-accent);"></i>
                            Rango de numeración
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="NumeroDesde" class="pa-label">Número desde *</label>
                                <input asp-for="NumeroDesde" type="number" class="pa-input"
                                       min="1" placeholder="Ej: 1"
                                       id="inputDesde" />
                                <span asp-validation-for="NumeroDesde" class="val-msg"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="NumeroHasta" class="pa-label">Número hasta *</label>
                                <input asp-for="NumeroHasta" type="number" class="pa-input"
                                       min="1" placeholder="Ej: 999"
                                       id="inputHasta" />
                                <span asp-validation-for="NumeroHasta" class="val-msg"></span>
                            </div>
                        </div>

                        <!-- Preview capacidad -->
                        <div id="previewCapacidad" style="display:none;margin-top:1rem;
                             background:rgba(59,130,246,.06);border:1px solid rgba(59,130,246,.2);
                             border-radius:8px;padding:.75rem 1rem;font-size:.83rem;">
                            <i class="fa-solid fa-circle-info me-2" style="color:var(--pa-info);"></i>
                            Este timbrado permitirá emitir
                            <strong id="txtCapacidad" style="color:var(--pa-info);"></strong> facturas.
                        </div>
                    </div>

                </div>

                <!-- Columna info -->
                <div class="col-lg-4">
                    <div class="pa-card p-4" style="position:sticky;top:1rem;">
                        <div class="section-title mb-3">
                            <i class="fa-solid fa-circle-info me-1" style="color:var(--pa-accent);"></i>
                            Información
                        </div>
                        <div style="font-size:0.83rem;color:var(--pa-muted);">
                            <p>
                                <i class="fa-solid fa-check-circle me-2" style="color:var(--pa-success);"></i>
                                El timbrado se activará automáticamente al guardarlo.
                            </p>
                            <p>
                                <i class="fa-solid fa-triangle-exclamation me-2" style="color:var(--pa-warning);"></i>
                                Solo puede haber <strong style="color:var(--pa-text);">un timbrado activo</strong> a la vez. Si ya existe uno activo, desactívelo antes de cargar el nuevo.
                            </p>
                            <p style="margin:0;">
                                <i class="fa-solid fa-file-invoice me-2" style="color:var(--pa-info);"></i>
                                Los datos deben coincidir exactamente con el documento emitido por la <strong style="color:var(--pa-text);">SET</strong>.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 justify-content-end mt-4 pb-3">
                <a href="/Timbrados" class="btn-pa-ghost">
                    <i class="fa-solid fa-xmark"></i> Cancelar
                </a>
                <button type="submit" class="btn-pa-primary" id="btnGuardar">
                    <i class="fa-solid fa-floppy-disk"></i> Guardar timbrado
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .val-msg { font-size: 0.78rem; color: #f87191; margin-top: 3px; display: block; }
    .action-btn {
        width: 34px; height: 34px; border-radius: 8px;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--pa-border); background: transparent;
        color: var(--pa-muted); text-decoration: none; transition: background var(--ease);
    }
    .action-btn:hover { background: rgba(255,255,255,0.06); color: var(--pa-text); }
</style>

<script>
    // ── Preview capacidad ─────────────────────────────────────────────────
    function actualizarCapacidad() {
        const desde = parseInt(document.getElementById('inputDesde').value) || 0;
        const hasta = parseInt(document.getElementById('inputHasta').value) || 0;

        if (desde > 0 && hasta > desde) {
            const capacidad = hasta - desde + 1;
            document.getElementById('txtCapacidad').textContent =
                capacidad.toLocaleString('es-PY');
            document.getElementById('previewCapacidad').style.display = '';
        } else {
            document.getElementById('previewCapacidad').style.display = 'none';
        }
    }

    document.getElementById('inputDesde').addEventListener('input', actualizarCapacidad);
    document.getElementById('inputHasta').addEventListener('input', actualizarCapacidad);

    // ── Submit loader ─────────────────────────────────────────────────────
    document.getElementById('formCrear').addEventListener('submit', () => {
        const btn = document.getElementById('btnGuardar');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Guardando...';
    });

    // Inicializar
    actualizarCapacidad();
</script>
</body>
</html>
