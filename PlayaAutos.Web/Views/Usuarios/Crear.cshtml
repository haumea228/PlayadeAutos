@* ═══════════════════════════════════════════════════
    Crear.cshtml  →  PlayaAutos.Web/Views/Usuarios/Crear.cshtml
    ═══════════════════════════════════════════════════ *@
@model PlayaAutos.Web.Models.UsuarioViewModel
@{
    Layout = null;
    ViewData["Title"] = "Nuevo Usuario";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PlayaAutos — Nuevo Usuario</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="pa-app">
    @await Html.PartialAsync("_Sidebar")
    <div class="pa-content">

        <div class="pa-page-header d-flex align-items-center gap-3">
            <a href="/Usuarios" class="action-btn" style="flex-shrink:0;" title="Volver">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h4><i class="fa-solid fa-user-plus me-2" style="color:var(--pa-accent);"></i>Nuevo Usuario</h4>
                <p>Complete los campos para crear un vendedor o administrador</p>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="pa-alert danger mb-3">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                <strong>Corrija los errores antes de continuar.</strong>
            </div>
        }

        <form asp-action="Crear" method="post" id="formCrear" novalidate>
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-lg-8">

                    <!-- Datos del usuario -->
                    <div class="pa-card p-4 mb-3">
                        <div class="section-title mb-3">
                            <i class="fa-solid fa-id-card me-1" style="color:var(--pa-accent);"></i>
                            Datos del usuario
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="UsuarioNombre" class="pa-label">Nombre *</label>
                                <input asp-for="UsuarioNombre" class="pa-input"
                                       placeholder="Ej: Juan Pérez" autofocus />
                                <span asp-validation-for="UsuarioNombre" class="val-msg"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UsuarioEmail" class="pa-label">Email *</label>
                                <input asp-for="UsuarioEmail" class="pa-input" type="email"
                                       placeholder="Ej: juan@playaautos.com" />
                                <span asp-validation-for="UsuarioEmail" class="val-msg"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UsuarioPhone" class="pa-label">Teléfono</label>
                                <input asp-for="UsuarioPhone" class="pa-input"
                                       placeholder="Ej: 0981 123 456" />
                                <span asp-validation-for="UsuarioPhone" class="val-msg"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Rol" class="pa-label">Rol *</label>
                                <select asp-for="Rol" class="pa-input">
                                    <option value="Vendedor">Vendedor</option>
                                    <option value="AdministradorP">Administrador</option>
                                </select>
                                <span asp-validation-for="Rol" class="val-msg"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Contraseña -->
                    <div class="pa-card p-4">
                        <div class="section-title mb-3">
                            <i class="fa-solid fa-lock me-1" style="color:var(--pa-accent);"></i>
                            Contraseña
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Password" class="pa-label">Contraseña *</label>
                                <div class="input-wrapper">
                                    <input asp-for="Password" type="password" class="pa-input"
                                           id="inputPassword" placeholder="Mín. 6 caracteres"
                                           style="padding-right:2.8rem !important;" />
                                    <span class="input-icon" style="cursor:pointer;right:.75rem;left:auto;"
                                          onclick="togglePass('inputPassword', this)">
                                        <i class="fa-solid fa-eye"></i>
                                    </span>
                                </div>
                                <span asp-validation-for="Password" class="val-msg"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="pa-label">Confirmar contraseña *</label>
                                <div class="input-wrapper">
                                    <input type="password" class="pa-input" id="inputConfirm"
                                           placeholder="Repita la contraseña"
                                           style="padding-right:2.8rem !important;" />
                                    <span class="input-icon" style="cursor:pointer;right:.75rem;left:auto;"
                                          onclick="togglePass('inputConfirm', this)">
                                        <i class="fa-solid fa-eye"></i>
                                    </span>
                                </div>
                                <span id="errorConfirm" class="val-msg" style="display:none;">
                                    Las contraseñas no coinciden.
                                </span>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Info -->
                <div class="col-lg-4">
                    <div class="pa-card p-4" style="position:sticky;top:1rem;">
                        <div class="section-title mb-3">
                            <i class="fa-solid fa-circle-info me-1" style="color:var(--pa-accent);"></i>
                            Roles disponibles
                        </div>
                        <div style="font-size:0.85rem;">
                            <div style="margin-bottom:1rem;padding:.75rem;background:rgba(59,130,246,.06);
                                        border:1px solid rgba(59,130,246,.2);border-radius:8px;">
                                <div style="font-weight:600;color:var(--pa-info);margin-bottom:.3rem;">
                                    <i class="fa-solid fa-user-tie me-1"></i> Vendedor
                                </div>
                                <div style="color:var(--pa-muted);font-size:0.8rem;">
                                    Puede registrar ventas, ver clientes y vehículos. No accede a configuración ni usuarios.
                                </div>
                            </div>
                            <div style="padding:.75rem;background:rgba(233,69,96,.06);
                                        border:1px solid rgba(233,69,96,.2);border-radius:8px;">
                                <div style="font-weight:600;color:var(--pa-accent);margin-bottom:.3rem;">
                                    <i class="fa-solid fa-shield-halved me-1"></i> Administrador
                                </div>
                                <div style="color:var(--pa-muted);font-size:0.8rem;">
                                    Acceso completo al sistema incluyendo usuarios, timbrados y reportes.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 justify-content-end mt-4 pb-3">
                <a href="/Usuarios" class="btn-pa-ghost">
                    <i class="fa-solid fa-xmark"></i> Cancelar
                </a>
                <button type="submit" class="btn-pa-primary" id="btnGuardar">
                    <i class="fa-solid fa-floppy-disk"></i> Crear usuario
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .val-msg { font-size: 0.78rem; color: #f87191; margin-top: 3px; display: block; }
    .action-btn {
        width: 34px; height: 34px; border-radius: 8px;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--pa-border); background: transparent;
        color: var(--pa-muted); text-decoration: none; transition: background var(--ease);
    }
    .action-btn:hover { background: rgba(255,255,255,0.06); color: var(--pa-text); }
</style>

<script>
    function togglePass(inputId, iconSpan) {
        const input = document.getElementById(inputId);
        const icon  = iconSpan.querySelector('i');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'fa-solid fa-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'fa-solid fa-eye';
        }
    }

    document.getElementById('formCrear').addEventListener('submit', function (e) {
        const pass    = document.getElementById('inputPassword').value;
        const confirm = document.getElementById('inputConfirm').value;
        const errSpan = document.getElementById('errorConfirm');

        if (pass !== confirm) {
            e.preventDefault();
            errSpan.style.display = 'block';
            return;
        }
        errSpan.style.display = 'none';

        const btn = document.getElementById('btnGuardar');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Creando...';
    });

    document.getElementById('inputConfirm').addEventListener('input', function () {
        const pass    = document.getElementById('inputPassword').value;
        const errSpan = document.getElementById('errorConfirm');
        errSpan.style.display = this.value && this.value !== pass ? 'block' : 'none';
    });
</script>
</body>
</html>
