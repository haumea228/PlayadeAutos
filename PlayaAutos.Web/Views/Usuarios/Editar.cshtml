@model PlayaAutos.Web.Models.UsuarioViewModel
@{
    Layout = null;
    ViewData["Title"] = "Editar Usuario";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PlayaAutos — Editar Usuario</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="pa-app">
    @await Html.PartialAsync("_Sidebar")
    <div class="pa-content">

        <div class="pa-page-header d-flex align-items-center gap-3">
            <a href="/Usuarios" class="action-btn" style="flex-shrink:0;" title="Volver">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h4><i class="fa-solid fa-user-pen me-2" style="color:var(--pa-accent);"></i>Editar Usuario</h4>
                <p>Modifique los datos del usuario</p>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="pa-alert danger mb-3">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                <strong>Corrija los errores antes de continuar.</strong>
            </div>
        }

        <form asp-action="Editar" asp-route-id="@Model.UsuarioId" method="post" id="formEditar" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UsuarioId" />

            <div class="row g-3">
                <div class="col-lg-8">

                    <!-- Datos del usuario -->
                    <div class="pa-card p-4 mb-3">
                        <div class="section-title mb-3">
                            <i class="fa-solid fa-id-card me-1" style="color:var(--pa-accent);"></i>
                            Datos del usuario
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="UsuarioNombre" class="pa-label">Nombre *</label>
                                <input asp-for="UsuarioNombre" class="pa-input" autofocus />
                                <span asp-validation-for="UsuarioNombre" class="val-msg"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UsuarioEmail" class="pa-label">Email *</label>
                                <input asp-for="UsuarioEmail" class="pa-input" type="email" />
                                <span asp-validation-for="UsuarioEmail" class="val-msg"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UsuarioPhone" class="pa-label">Teléfono</label>
                                <input asp-for="UsuarioPhone" class="pa-input" />
                                <span asp-validation-for="UsuarioPhone" class="val-msg"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Rol" class="pa-label">Rol *</label>
                                <select asp-for="Rol" class="pa-input">
                                    <option value="Vendedor">Vendedor</option>
                                    <option value="AdministradorP">Administrador</option>
                                </select>
                                <span asp-validation-for="Rol" class="val-msg"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Cambiar contraseña (opcional) -->
                    <div class="pa-card p-4">
                        <div class="section-title mb-1">
                            <i class="fa-solid fa-lock me-1" style="color:var(--pa-accent);"></i>
                            Cambiar contraseña
                            <span style="font-weight:400;color:var(--pa-muted);font-size:0.82rem;margin-left:.4rem;">
                                (dejar en blanco para mantener la actual)
                            </span>
                        </div>
                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <label asp-for="NuevaPassword" class="pa-label">Nueva contraseña</label>
                                <div class="input-wrapper">
                                    <input asp-for="NuevaPassword" type="password" class="pa-input"
                                           id="inputNuevaPass" placeholder="Mín. 6 caracteres"
                                           style="padding-right:2.8rem !important;" />
                                    <span class="input-icon" style="cursor:pointer;right:.75rem;left:auto;"
                                          onclick="togglePass('inputNuevaPass', this)">
                                        <i class="fa-solid fa-eye"></i>
                                    </span>
                                </div>
                                <span asp-validation-for="NuevaPassword" class="val-msg"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="pa-label">Confirmar nueva contraseña</label>
                                <div class="input-wrapper">
                                    <input type="password" class="pa-input" id="inputConfirmNueva"
                                           placeholder="Repita la nueva contraseña"
                                           style="padding-right:2.8rem !important;" />
                                    <span class="input-icon" style="cursor:pointer;right:.75rem;left:auto;"
                                          onclick="togglePass('inputConfirmNueva', this)">
                                        <i class="fa-solid fa-eye"></i>
                                    </span>
                                </div>
                                <span id="errorConfirmNueva" class="val-msg" style="display:none;">
                                    Las contraseñas no coinciden.
                                </span>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Estado -->
                <div class="col-lg-4">
                    <div class="pa-card p-4" style="position:sticky;top:1rem;">
                        <div class="section-title mb-3">
                            <i class="fa-solid fa-toggle-on me-1" style="color:var(--pa-accent);"></i>
                            Estado de la cuenta
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="ActivoUsuario" class="form-check-input" type="checkbox"
                                   role="switch" id="switchActivo"
                                   style="cursor:pointer;width:3em;height:1.5em;" />
                            <label class="form-check-label" for="switchActivo" style="cursor:pointer;font-weight:600;">
                                <span id="estadoTexto">@(Model.ActivoUsuario ? "Cuenta activa" : "Cuenta inactiva")</span>
                            </label>
                        </div>

                        <hr style="border-color:var(--pa-border);" />

                        <div style="font-size:0.82rem;color:var(--pa-muted);">
                            <p>
                                <i class="fa-solid fa-circle-info me-2" style="color:var(--pa-info);"></i>
                                ID del usuario: <strong>@Model.UsuarioId</strong>
                            </p>
                            <p style="margin:0;">
                                <i class="fa-solid fa-triangle-exclamation me-2" style="color:var(--pa-warning);"></i>
                                Un usuario inactivo no podrá iniciar sesión en el sistema.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 justify-content-end mt-4 pb-3">
                <a href="/Usuarios" class="btn-pa-ghost">
                    <i class="fa-solid fa-xmark"></i> Cancelar
                </a>
                <button type="submit" class="btn-pa-primary" id="btnGuardar">
                    <i class="fa-solid fa-floppy-disk"></i> Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .val-msg { font-size: 0.78rem; color: #f87191; margin-top: 3px; display: block; }
    .action-btn {
        width: 34px; height: 34px; border-radius: 8px;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--pa-border); background: transparent;
        color: var(--pa-muted); text-decoration: none; transition: background var(--ease);
    }
    .action-btn:hover { background: rgba(255,255,255,0.06); color: var(--pa-text); }
    .form-check-input:checked { background-color: #22c55e; border-color: #22c55e; }
</style>

<script>
    function togglePass(inputId, iconSpan) {
        const input = document.getElementById(inputId);
        const icon  = iconSpan.querySelector('i');
        input.type = input.type === 'password' ? 'text' : 'password';
        icon.className = input.type === 'password' ? 'fa-solid fa-eye' : 'fa-solid fa-eye-slash';
    }

    document.getElementById('switchActivo').addEventListener('change', function () {
        document.getElementById('estadoTexto').textContent =
            this.checked ? 'Cuenta activa' : 'Cuenta inactiva';
    });

    document.getElementById('inputConfirmNueva').addEventListener('input', function () {
        const nueva   = document.getElementById('inputNuevaPass').value;
        const errSpan = document.getElementById('errorConfirmNueva');
        errSpan.style.display = this.value && this.value !== nueva ? 'block' : 'none';
    });

    document.getElementById('formEditar').addEventListener('submit', function (e) {
        const nueva   = document.getElementById('inputNuevaPass').value;
        const confirm = document.getElementById('inputConfirmNueva').value;
        const errSpan = document.getElementById('errorConfirmNueva');

        if (nueva && nueva !== confirm) {
            e.preventDefault();
            errSpan.style.display = 'block';
            return;
        }
        errSpan.style.display = 'none';

        const btn = document.getElementById('btnGuardar');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Guardando...';
    });
</script>
</body>
</html>
