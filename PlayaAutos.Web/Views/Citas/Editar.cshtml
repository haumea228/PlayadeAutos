@model PlayaAutos.Web.Models.CitaViewModel
@{
    Layout = null;
    ViewData["Title"] = "Editar Cita";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PlayaAutos — Editar Cita</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="pa-app">
    @await Html.PartialAsync("_Sidebar")
    <div class="pa-content">

        <div class="pa-page-header d-flex align-items-center gap-3">
            <a href="/Citas" class="action-btn" style="flex-shrink:0;" title="Volver">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h4><i class="fa-solid fa-calendar-pen me-2" style="color:var(--pa-accent);"></i>Editar Cita</h4>
                <p>Modifique los datos de la cita</p>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="pa-alert danger mb-3">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                <strong>Corrija los errores antes de continuar.</strong>
            </div>
        }

        <form asp-action="Editar" asp-route-id="@Model.CitaId" method="post" id="formEditar" novalidate>
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-lg-8">
                    <div class="pa-card p-4 mb-3">
                        <div class="section-title mb-3">
                            <i class="fa-solid fa-user-group me-1" style="color:var(--pa-accent);"></i>
                            Participantes
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="ClienteId" class="pa-label">Cliente *</label>
                                <select asp-for="ClienteId" asp-items="Model.Clientes" class="pa-input">
                                    <option value="">— Seleccione —</option>
                                </select>
                                <span asp-validation-for="ClienteId" class="val-msg"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="VendedorId" class="pa-label">Vendedor *</label>
                                <select asp-for="VendedorId" asp-items="Model.Vendedores" class="pa-input">
                                    <option value="">— Seleccione —</option>
                                </select>
                                <span asp-validation-for="VendedorId" class="val-msg"></span>
                            </div>
                        </div>
                    </div>

                    <div class="pa-card p-4 mb-3">
                        <div class="section-title mb-3">
                            <i class="fa-solid fa-clock me-1" style="color:var(--pa-accent);"></i>
                            Fecha y Tipo
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="FechaHora" class="pa-label">Fecha y hora *</label>
                                <input asp-for="FechaHora" type="datetime-local" class="pa-input" />
                                <span asp-validation-for="FechaHora" class="val-msg"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="TipoCita" class="pa-label">Tipo *</label>
                                <select asp-for="TipoCita" asp-items="Model.TiposCita" class="pa-input">
                                    <option value="">— Seleccione —</option>
                                </select>
                                <span asp-validation-for="TipoCita" class="val-msg"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="VehiculoId" class="pa-label">Vehículo</label>
                                <select asp-for="VehiculoId" asp-items="Model.Vehiculos" class="pa-input">
                                    <option value="">— Sin vehículo —</option>
                                </select>
                                <span asp-validation-for="VehiculoId" class="val-msg"></span>
                            </div>
                        </div>
                    </div>

                    <div class="pa-card p-4">
                        <div class="section-title mb-3">
                            <i class="fa-solid fa-note-sticky me-1" style="color:var(--pa-accent);"></i>
                            Observaciones
                        </div>
                        <textarea asp-for="Observaciones" class="pa-input" rows="3"
                                  placeholder="Notas adicionales..." style="resize:vertical;"></textarea>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="pa-card p-4" style="position:sticky;top:1rem;">
                        <div class="section-title mb-3">
                            <i class="fa-solid fa-circle-info me-1" style="color:var(--pa-accent);"></i>
                            Información de la Cita
                        </div>
                        
                        <div style="font-size:0.85rem;">
                            <div class="detalle-row">
                                <span class="detalle-label">Cliente</span>
                                <span class="detalle-valor">@(Model.NombreCliente ?? "—")</span>
                            </div>
                            <div class="detalle-row">
                                <span class="detalle-label">Vehículo</span>
                                <span class="detalle-valor">@(Model.VehiculoInfo ?? "Sin vehículo")</span>
                            </div>
                            <div class="detalle-row">
                                <span class="detalle-label">Vendedor</span>
                                <span class="detalle-valor">@(Model.VendedorNombre ?? "—")</span>
                            </div>
                        </div>
                        
                        <hr style="border-color:var(--pa-border);" />
                        
                        <div style="font-size:0.85rem;">
                            <div class="detalle-row">
                                <span class="detalle-label">Estado actual</span>
                                <span class="estado-badge" style="background:@(Model.EstadoColor ?? "rgba(107,114,128,.12)");">
                                    @(Model.EstadoDescripcion ?? "Desconocido")
                                </span>
                            </div>
                        </div>
                        
                        <div style="margin-top:1rem;padding:0.75rem;background:var(--pa-bg);border-radius:8px;border:1px solid var(--pa-border);font-size:0.78rem;color:var(--pa-muted);">
                            <i class="fa-solid fa-circle-info me-1" style="color:var(--pa-info);"></i>
                            Para cambiar el estado, use los botones en el listado de citas.
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 justify-content-end mt-4 pb-3">
                <a href="/Citas" class="btn-pa-ghost">
                    <i class="fa-solid fa-xmark"></i> Cancelar
                </a>
                <button type="submit" class="btn-pa-primary" id="btnGuardar">
                    <i class="fa-solid fa-floppy-disk"></i> Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .val-msg { font-size: 0.78rem; color: #f87191; margin-top: 3px; display: block; }
    .action-btn {
        width: 34px; height: 34px;
        border-radius: 8px;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--pa-border);
        background: transparent;
        color: var(--pa-muted);
        text-decoration: none;
        transition: background var(--ease);
    }
    .action-btn:hover { background: rgba(255,255,255,0.06); color: var(--pa-text); }
    .detalle-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--pa-border);
    }
    .detalle-row:last-child {
        border-bottom: none;
    }
    .detalle-label {
        color: var(--pa-muted);
        font-size: 0.82rem;
    }
    .detalle-valor {
        font-weight: 600;
        color: var(--pa-text);
        font-size: 0.85rem;
        text-align: right;
    }
    .estado-badge {
        display: inline-block;
        padding: 0.2em 0.65em;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 50px;
    }
</style>

<script>
    document.getElementById('formEditar').addEventListener('submit', () => {
        const btn = document.getElementById('btnGuardar');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Guardando...';
    });
</script>
</body>
</html>