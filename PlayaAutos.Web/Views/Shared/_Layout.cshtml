<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — PlayaAutos</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Site styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PlayaAutos.Web.styles.css" asp-append-version="true" />
    <style>
        .nav-logo {
            height: 52px;
            width: auto;
            display: block;
            object-fit: contain;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar pa-navbar navbar-expand-sm">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="nav-logo-block">
                        <img src="~/images/logo.png" alt="A&J Autos Usados" class="nav-logo nav-logo-img-wrap"
                             onerror="this.style.display='none';this.closest('.nav-logo-block').querySelector('.nav-logo-text').style.display='flex';" />
                        <div class="nav-logo-text" style="display:none;align-items:center;gap:0.5rem;">
                            <div class="brand-icon"><i class="fa-solid fa-car-side"></i></div>
                            <span>A&amp;J <span>Autos</span></span>
                        </div>
                    </div>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fa-solid fa-bars" style="color:var(--pa-muted);font-size:1rem;"></i>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-house me-1"></i>Inicio
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link btn-pa-primary ms-2 px-3 py-2" asp-area="" asp-controller="Auth" asp-action="Login">
                                <i class="fa-solid fa-right-to-bracket me-1"></i>Acceder
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="pa-footer">
        <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span>&copy; 2026 <strong style="color:var(--pa-text)">PlayaAutos</strong> — Sistema de Gestión Automotriz</span>
            <span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
            </span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
