@model List<PlayaAutos.Web.Models.TasacionListItem>
@{
    Layout = null;
    ViewData["Title"] = "Tasaciones";
    var filtroActual = ViewBag.FiltroActual as string ?? "todas";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PlayaAutos — Tasaciones</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="pa-app">

        @await Html.PartialAsync("_Sidebar")

        <div class="pa-content">

            <div class="pa-page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <h4><i class="fa-solid fa-car-burst me-2" style="color:var(--pa-accent);"></i>Tasaciones</h4>
                    <p>Gestión de tasaciones de vehículos para permuta</p>
                </div>
                <a href="/Tasaciones/Crear" class="btn-pa-primary">
                    <i class="fa-solid fa-plus"></i> Nueva tasación
                </a>
            </div>

            @if (TempData["Exito"] != null)
            {
                <div class="pa-alert success mb-3">
                    <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="pa-alert danger mb-3">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
                </div>
            }

            <!-- Filtros -->
            <div class="pa-card p-3 mb-3">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <a href="/Tasaciones?filtro=todas"
                       class="filtro-btn @(filtroActual == "todas" ? "active" : "")">
                        Todas
                    </a>
                    <a href="/Tasaciones?filtro=pendientes"
                       class="filtro-btn @(filtroActual == "pendientes" ? "active" : "")">
                        <i class="fa-solid fa-clock me-1"></i>Pendientes
                    </a>
                    <a href="/Tasaciones?filtro=Aprobada"
                       class="filtro-btn @(filtroActual == "Aprobada" ? "active" : "")">
                        <i class="fa-solid fa-check me-1"></i>Aprobadas
                    </a>
                    <a href="/Tasaciones?filtro=Rechazada"
                       class="filtro-btn @(filtroActual == "Rechazada" ? "active" : "")">
                        <i class="fa-solid fa-xmark me-1"></i>Rechazadas
                    </a>
                    <a href="/Tasaciones?filtro=Usada"
                       class="filtro-btn @(filtroActual == "Usada" ? "active" : "")">
                        <i class="fa-solid fa-rotate me-1"></i>Usadas
                    </a>
                    <div class="ms-auto input-wrapper" style="max-width:280px;">
                        <input type="text" id="buscador" class="pa-input"
                               placeholder="Buscar cliente, marca, modelo..." />
                        <i class="fa-solid fa-magnifying-glass input-icon"></i>
                    </div>
                </div>
            </div>

            <!-- Tabla -->
            <div class="pa-card" style="overflow:hidden;">
                @if (!Model.Any())
                {
                    <div style="text-align:center;padding:4rem 2rem;">
                        <i class="fa-solid fa-car-burst" style="font-size:3rem;color:var(--pa-border);display:block;margin-bottom:1rem;"></i>
                        <p style="color:var(--pa-muted);margin:0;">No hay tasaciones registradas.</p>
                        <a href="/Tasaciones/Crear" class="btn-pa-primary mt-3 d-inline-flex">
                            <i class="fa-solid fa-plus"></i> Registrar primera tasación
                        </a>
                    </div>
                }
                else
                {
                    <div style="overflow-x:auto;">
                        <table class="pa-table" id="tablaTasaciones">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Cliente</th>
                                    <th>Vehículo</th>
                                    <th>Año</th>
                                    <th>Valor tasación</th>
                                    <th>Precio venta</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in Model)
                                {
                                    <tr>
                                        <td style="font-family:monospace;font-size:0.8rem;color:var(--pa-muted);">
                                            #@t.TasacionVehiculoId
                                        </td>
                                        <td style="font-weight:600;">@t.Cliente</td>
                                        <td style="font-size:0.88rem;">@t.MarcaVehiculo @t.ModeloVehiculo</td>
                                        <td style="font-size:0.85rem;">@t.AnhoVehiculo</td>
                                        <td style="font-weight:600;font-size:0.88rem;">
                                            Gs. @t.ValorTasacion.ToString("N0")
                                        </td>
                                        <td style="font-size:0.85rem;">
                                            Gs. @t.PrecioVenta.ToString("N0")
                                        </td>
                                        <td style="font-size:0.82rem;color:var(--pa-muted);">
                                            @t.FechaTasacion.ToString("dd/MM/yyyy")
                                        </td>
                                        <td>
                                            @switch (t.EstadoTasacion)
                                            {
                                                case "Pendiente":
                                                    <span class="estado-badge" style="background:rgba(234,179,8,.12);color:#ca8a04;">
                                                        <i class="fa-solid fa-clock fa-xs me-1"></i>Pendiente
                                                    </span>
                                                    break;
                                                case "Aprobada":
                                                    <span class="estado-badge" style="background:rgba(34,197,94,.12);color:#22c55e;">
                                                        <i class="fa-solid fa-check fa-xs me-1"></i>Aprobada
                                                    </span>
                                                    break;
                                                case "Usada":
                                                    <span class="estado-badge" style="background:rgba(99,102,241,.12);color:#818cf8;">
                                                        <i class="fa-solid fa-rotate fa-xs me-1"></i>Usada
                                                    </span>
                                                    break;
                                                default:
                                                    <span class="estado-badge" style="background:rgba(239,68,68,.12);color:#ef4444;">
                                                        <i class="fa-solid fa-xmark fa-xs me-1"></i>Rechazada
                                                    </span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                @if (t.EstadoTasacion == "Pendiente")
                                                {
                                                    <a href="/Tasaciones/Aprobar/@t.TasacionVehiculoId"
                                                       class="action-btn" title="Aprobar"
                                                       style="color:#22c55e;border-color:rgba(34,197,94,.3);">
                                                        <i class="fa-solid fa-check"></i>
                                                    </a>
                                                    <form method="post" action="/Tasaciones/Rechazar/@t.TasacionVehiculoId"
                                                          style="display:inline;" id="formRechazar_@t.TasacionVehiculoId">
                                                        @Html.AntiForgeryToken()
                                                        <button type="button" class="action-btn delete"
                                                                onclick="confirmarRechazar(@t.TasacionVehiculoId, '@(t.MarcaVehiculo + " " + t.ModeloVehiculo)')"
                                                                title="Rechazar">
                                                            <i class="fa-solid fa-xmark"></i>
                                                        </button>
                                                    </form>
                                                }
                                             
                                                else
                                                {
                                                    <span style="color:var(--pa-muted);font-size:0.75rem;">—</span>
                                                }
                                                @if (t.EstadoTasacion == "Rechazada")
                                                {
                                                    <span style="color:var(--pa-muted);font-size:0.75rem;">—</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @if (Model.Any())
            {
                <p style="font-size:0.8rem;color:var(--pa-muted);margin-top:0.75rem;text-align:right;">
                    <span id="totalVisible">@Model.Count</span> tasación(es)
                </p>
            }
        </div>
    </div>

    <!-- Modal Rechazar -->
    <div id="modalRechazar" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:1000;align-items:center;justify-content:center;">
        <div style="background:var(--pa-surface);border:1px solid var(--pa-border);border-radius:14px;padding:2rem;max-width:440px;width:90%;">
            <div style="text-align:center;margin-bottom:1.25rem;">
                <div style="width:54px;height:54px;background:rgba(233,69,96,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 0.75rem;">
                    <i class="fa-solid fa-xmark" style="color:var(--pa-accent);font-size:1.3rem;"></i>
                </div>
                <h5 style="font-weight:700;margin-bottom:0.25rem;">Rechazar tasación</h5>
                <p style="color:var(--pa-muted);font-size:0.9rem;margin:0;" id="msgRechazar"></p>
            </div>
            <div class="d-flex gap-2 justify-content-end">
                <button type="button" class="btn-pa-ghost" onclick="cerrarModalRechazar()">Cancelar</button>
                <button type="button" class="btn-pa-primary" id="btnConfirmarRechazar"
                        style="background:#ef4444;border-color:#ef4444;">
                    <i class="fa-solid fa-xmark me-1"></i>Rechazar
                </button>
            </div>
        </div>
    </div>

    <style>
            .estado-badge {
                display: inline-flex;
                align-items: center;
                padding: 0.2em 0.65em;
                font-size: 0.75rem;
                font-weight: 600;
                border-radius: 50px;
            }

            .filtro-btn {
                display: inline-flex;
                align-items: center;
                padding: 0.3rem 0.8rem;
                border-radius: 8px;
                border: 1px solid var(--pa-border);
                font-size: 0.82rem;
                color: var(--pa-muted);
                text-decoration: none;
                transition: background var(--ease), color var(--ease), border-color var(--ease);
            }

                .filtro-btn:hover {
                    background: rgba(255,255,255,.05);
                    color: var(--pa-text);
                }

                .filtro-btn.active {
                    background: rgba(233,69,96,.1);
                    border-color: var(--pa-accent);
                    color: var(--pa-accent);
                }

            .action-btn {
                width: 32px;
                height: 32px;
                border-radius: 7px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 0.8rem;
                border: 1px solid var(--pa-border);
                background: transparent;
                cursor: pointer;
                transition: background var(--ease), border-color var(--ease);
                color: var(--pa-muted);
                text-decoration: none;
            }

                .action-btn.delete:hover {
                    background: rgba(233,69,96,.12);
                    border-color: var(--pa-accent);
                    color: var(--pa-accent);
                }
    </style>

    <script>
            let rechazarId = null;

            function confirmarRechazar(id, vehiculo) {
                rechazarId = id;
                document.getElementById('msgRechazar').textContent =
                    `¿Seguro que desea rechazar la tasación del vehículo "${vehiculo}"?`;
                document.getElementById('modalRechazar').style.display = 'flex';
            }

            function cerrarModalRechazar() {
                document.getElementById('modalRechazar').style.display = 'none';
                rechazarId = null;
            }

            document.getElementById('btnConfirmarRechazar').addEventListener('click', function () {
                if (rechazarId) document.getElementById('formRechazar_' + rechazarId).submit();
            });

            document.getElementById('modalRechazar').addEventListener('click', function (e) {
                if (e.target === this) cerrarModalRechazar();
            });

            // Buscador
            document.getElementById('buscador').addEventListener('input', function () {
                const q = this.value.toLowerCase();
                let vis = 0;
                document.querySelectorAll('#tablaTasaciones tbody tr').forEach(tr => {
                    const ok = !q || tr.textContent.toLowerCase().includes(q);
                    tr.style.display = ok ? '' : 'none';
                    if (ok) vis++;
                });
                const t = document.getElementById('totalVisible');
                if (t) t.textContent = vis;
            });
    </script>
</body>
</html>