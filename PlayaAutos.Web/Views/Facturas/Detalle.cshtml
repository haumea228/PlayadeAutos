@model PlayaAutos.Web.Models.FacturaViewModel
@{
    Layout = null;
    ViewData["Title"] = $"Factura {Model.NumeroFactura}";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PlayaAutos — Factura @Model.NumeroFactura</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .factura-header {
            border-bottom: 2px solid var(--pa-accent);
            padding-bottom: 1.5rem;
            margin-bottom: 1.5rem;
        }
        .factura-titulo {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--pa-accent);
            letter-spacing: -0.5px;
        }
        .factura-numero {
            font-family: monospace;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--pa-text);
        }
        .detalle-row {
            display: flex;
            justify-content: space-between;
            padding: 0.6rem 0;
            border-bottom: 1px solid var(--pa-border);
            font-size: 0.9rem;
        }
        .detalle-row:last-child {
            border-bottom: none;
        }
        .detalle-label {
            color: var(--pa-muted);
        }
        .detalle-valor {
            font-weight: 600;
            color: var(--pa-text);
        }
        .total-final {
            font-size: 1.3rem;
            font-weight: 800;
            color: var(--pa-success);
        }
    </style>
</head>
<body>
<div class="pa-app">

    @await Html.PartialAsync("_Sidebar")

    <div class="pa-content">

        <div class="pa-page-header d-flex align-items-center gap-3">
            <a href="/Facturas" class="action-btn" style="flex-shrink:0;" title="Volver">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h4><i class="fa-solid fa-file-invoice me-2" style="color:var(--pa-accent);"></i>Detalle de Factura</h4>
                <p>@Model.NumeroFactura</p>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-8">
                <!-- Datos de la factura -->
                <div class="pa-card p-4 mb-3">
                    <div class="factura-header">
                        <div class="factura-titulo">FACTURA</div>
                        <div class="factura-numero">N° @Model.NumeroFactura</div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="detalle-row">
                                <span class="detalle-label">Fecha de emisión</span>
                                <span class="detalle-valor">@Model.FechaEmision.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="detalle-row">
                                <span class="detalle-label">Timbrado</span>
                                <span class="detalle-valor">@Model.Timbrado</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="detalle-row">
                                <span class="detalle-label">Cliente</span>
                                <span class="detalle-valor">@Model.Cliente</span>
                            </div>
                            <div class="detalle-row">
                                <span class="detalle-label">Vehículo</span>
                                <span class="detalle-valor">@Model.Vehiculo</span>
                            </div>
                        </div>
                    </div>

                    <!-- Montos -->
                    <div style="background:var(--pa-bg);border-radius:8px;padding:1.5rem;">
                        <div class="detalle-row">
                            <span class="detalle-label">Subtotal (sin IVA)</span>
                            <span class="detalle-valor">Gs. @Model.Subtotal.ToString("N0")</span>
                        </div>
                        <div class="detalle-row">
                            <span class="detalle-label">IVA (10%)</span>
                            <span class="detalle-valor">Gs. @Model.IVA.ToString("N0")</span>
                        </div>
                        <div class="detalle-row" style="border-bottom:2px solid var(--pa-accent);margin-bottom:0.5rem;">
                            <span class="detalle-label" style="font-weight:700;">TOTAL</span>
                            <span class="total-final">Gs. @Model.Total.ToString("N0")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="pa-card p-4" style="position:sticky;top:1rem;">
                    <div class="section-title mb-3">
                        <i class="fa-solid fa-circle-info me-1" style="color:var(--pa-accent);"></i>
                        Acciones
                    </div>

                    @if (!string.IsNullOrEmpty(Model.RutaPDF))
                    {
                        <a href="/Facturas/DescargarPDF/@Model.FacturaId" 
                           class="btn-pa-primary w-100 mb-2" target="_blank">
                            <i class="fa-solid fa-file-pdf me-2"></i> Descargar PDF
                        </a>
                    }
                    else
                    {
                        <button class="btn-pa-primary w-100 mb-2" disabled style="opacity:0.5;">
                            <i class="fa-solid fa-file-pdf me-2"></i> PDF no disponible
                        </button>
                    }

                    <hr style="border-color:var(--pa-border);" />

                    <div style="font-size:0.82rem;color:var(--pa-muted);">
                        <p><i class="fa-solid fa-check-circle me-2" style="color:var(--pa-success);"></i>Factura generada automáticamente.</p>
                        <p style="margin:0;"><i class="fa-solid fa-shield-halved me-2" style="color:var(--pa-info);"></i>Documento fiscal válido.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .action-btn {
        width: 34px; height: 34px;
        border-radius: 8px;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--pa-border);
        background: transparent;
        color: var(--pa-muted);
        text-decoration: none;
        transition: background var(--ease);
    }
    .action-btn:hover { background: rgba(255,255,255,0.06); color: var(--pa-text); }
</style>
</body>
</html>