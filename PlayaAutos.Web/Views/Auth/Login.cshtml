@model PlayaAutos.Web.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PlayaAutos — Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
            body { background-color: #1a1a2e; }
            .login-card {
                background: #16213e;
                border-radius: 12px;
                border: 1px solid #0f3460;
            }
            .btn-primary { background-color: #0f3460; border-color: #0f3460; }
            .btn-primary:hover { background-color: #e94560; border-color: #e94560; }
            .text-brand { color: #e94560; }
    </style>
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100">
    <div class="login-card p-4 shadow" style="width: 100%; max-width: 400px;">
        <div class="text-center mb-4">
            <h2 class="text-white fw-bold">🚗 PlayaAutos</h2>
            <p class="text-muted">Sistema de Gestión</p>
        </div>

        <form asp-action="Login" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <div class="mb-3">
                <label class="form-label text-white">Email</label>
                <input asp-for="Email" class="form-control bg-dark text-white border-secondary"
                       placeholder="usuario@playaautos.com" />
            </div>

            <div class="mb-4">
                <label class="form-label text-white">Contraseña</label>
                <input asp-for="Password" class="form-control bg-dark text-white border-secondary"
                       placeholder="••••••••" />
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2">
                Iniciar Sesión
            </button>
        </form>
    </div>
</body>
</html>