@model List<PlayaAutos.Web.Models.ClienteListItem>
@{
    Layout = null;
    ViewData["Title"] = "Clientes";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PlayaAutos — Clientes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="pa-app">

    @await Html.PartialAsync("_Sidebar")

    <div class="pa-content">

        <!-- Header -->
        <div class="pa-page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h4><i class="fa-solid fa-users me-2" style="color:var(--pa-accent);"></i>Clientes</h4>
                <p>Gestión de clientes registrados</p>
            </div>
            <a href="/Clientes/Crear" class="btn-pa-primary">
                <i class="fa-solid fa-plus"></i> Registrar cliente
            </a>
        </div>

        <!-- Alertas -->
        @if (TempData["Exito"] != null)
        {
            <div class="pa-alert success mb-3">
                <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="pa-alert danger mb-3">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            </div>
        }

        <!-- Buscador -->
        <div class="pa-card p-3 mb-3">
            <div class="input-wrapper" style="max-width:380px;">
                <input type="text" id="buscador" class="pa-input" placeholder="Buscar por nombre, CI/RUC, teléfono..." />
                <i class="fa-solid fa-magnifying-glass input-icon"></i>
            </div>
        </div>

        <!-- Tabla -->
        <div class="pa-card" style="overflow:hidden;">
            @if (!Model.Any())
            {
                <div style="text-align:center;padding:4rem 2rem;">
                    <i class="fa-solid fa-user-group" style="font-size:3rem;color:var(--pa-border);display:block;margin-bottom:1rem;"></i>
                    <p style="color:var(--pa-muted);margin:0;">No hay clientes registrados.</p>
                    <a href="/Clientes/Crear" class="btn-pa-primary mt-3 d-inline-flex">
                        <i class="fa-solid fa-plus"></i> Registrar el primero
                    </a>
                </div>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="pa-table" id="tablaClientes">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>CI / RUC</th>
                                <th>Teléfono</th>
                                <th>Email</th>
                                <th>Dirección</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model)
                            {
                                <tr>
                                    <td>
                                        <div style="font-weight:600;">@c.Nombre</div>
                                        <div style="font-size:0.78rem;color:var(--pa-muted);">ID: @c.ClienteId</div>
                                    </td>
                                    <td>
                                        <span style="font-family:monospace;font-size:0.82rem;background:var(--pa-bg);padding:2px 7px;border-radius:5px;border:1px solid var(--pa-border);">
                                            @c.CI_RUC
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(c.Telefono))
                                        {
                                            <span>@c.Telefono</span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--pa-muted);">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(c.Email))
                                        {
                                            <a href="mailto:@c.Email" style="color:var(--pa-info);text-decoration:none;">@c.Email</a>
                                        }
                                        else
                                        {
                                            <span style="color:var(--pa-muted);">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(c.Direccion))
                                        {
                                            <span style="font-size:0.85rem;">@c.Direccion</span>
                                        }
                                        else
                                        {
                                            <span style="color:var(--pa-muted);">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (c.Activo)
                                        {
                                            <span class="estado-badge" style="background:rgba(34,197,94,.12);color:#22c55e;">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="estado-badge" style="background:rgba(239,68,68,.12);color:#ef4444;">Inactivo</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a href="/Clientes/Editar/@c.ClienteId" class="action-btn edit" title="Editar">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <button type="button" class="action-btn delete"
                                                    onclick="confirmarEliminar(@c.ClienteId, '@c.Nombre.Replace("'", "\\'")')"
                                                    title="Eliminar">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Total -->
        @if (Model.Any())
        {
            <p style="font-size:0.8rem;color:var(--pa-muted);margin-top:0.75rem;text-align:right;">
                <span id="totalVisible">@Model.Count</span> cliente(s)
            </p>
        }

    </div>
</div>

<!-- Modal de eliminación -->
<div id="modalEliminar" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:1000;align-items:center;justify-content:center;">
    <div style="background:var(--pa-surface);border:1px solid var(--pa-border);border-radius:14px;padding:2rem;max-width:420px;width:90%;text-align:center;">
        <div style="width:54px;height:54px;background:rgba(233,69,96,.12);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 1rem;">
            <i class="fa-solid fa-trash" style="color:var(--pa-accent);font-size:1.3rem;"></i>
        </div>
        <h5 style="margin-bottom:0.5rem;font-weight:700;">Eliminar cliente</h5>
        <p style="color:var(--pa-muted);font-size:0.9rem;margin-bottom:1.5rem;" id="msgEliminar"></p>
        <form id="formEliminar" method="post">
            @Html.AntiForgeryToken()
            <div class="d-flex gap-2 justify-content-center">
                <button type="button" class="btn-pa-ghost" onclick="cerrarModal()">Cancelar</button>
                <button type="submit" class="btn-pa-primary">Sí, eliminar</button>
            </div>
        </form>
    </div>
</div>

<style>
    .estado-badge {
        display: inline-block;
        padding: 0.2em 0.65em;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 50px;
    }
    .action-btn {
        width: 32px; height: 32px;
        border-radius: 7px;
        display: flex; align-items: center; justify-content: center;
        font-size: 0.8rem;
        border: 1px solid var(--pa-border);
        background: transparent;
        cursor: pointer;
        transition: background var(--ease), border-color var(--ease);
        text-decoration: none;
        color: var(--pa-muted);
    }
    .action-btn.edit:hover  { background: rgba(59,130,246,.12); border-color: var(--pa-info); color: var(--pa-info); }
    .action-btn.delete:hover { background: rgba(233,69,96,.12); border-color: var(--pa-accent); color: var(--pa-accent); }
</style>

<script>
    // ── Buscador ─────────────────────────────────────────────────────────
    document.getElementById('buscador').addEventListener('input', function () {
        const q = this.value.toLowerCase();
        const filas = document.querySelectorAll('#tablaClientes tbody tr');
        let visibles = 0;
        filas.forEach(tr => {
            const texto = tr.textContent.toLowerCase();
            const mostrar = texto.includes(q);
            tr.style.display = mostrar ? '' : 'none';
            if (mostrar) visibles++;
        });
        const t = document.getElementById('totalVisible');
        if (t) t.textContent = visibles;
    });

    // ── Modal eliminar ───────────────────────────────────────────────────
    function confirmarEliminar(id, nombre) {
        document.getElementById('msgEliminar').textContent =
            `¿Está seguro que desea eliminar a "${nombre}"? Esta acción no se puede deshacer.`;
        document.getElementById('formEliminar').action = '/Clientes/Eliminar/' + id;
        document.getElementById('modalEliminar').style.display = 'flex';
    }

    function cerrarModal() {
        document.getElementById('modalEliminar').style.display = 'none';
    }

    document.getElementById('modalEliminar').addEventListener('click', function (e) {
        if (e.target === this) cerrarModal();
    });
</script>
</body>
</html>
