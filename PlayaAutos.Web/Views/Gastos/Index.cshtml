@model List<PlayaAutos.Web.Models.GastoListItem>
@{
    Layout = null;
    ViewData["Title"] = "Gastos";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PlayaAutos — Gastos</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="pa-app">
        @await Html.PartialAsync("_Sidebar")
        <div class="pa-content">

            <div class="pa-page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <h4><i class="fa-solid fa-receipt me-2" style="color:var(--pa-accent);"></i>Gastos</h4>
                    <p>Registro de gastos por vehículo</p>
                </div>
                <a href="/Gastos/Crear" class="btn-pa-primary">
                    <i class="fa-solid fa-plus"></i> Nuevo Gasto
                </a>
            </div>

            @if (TempData["Exito"] != null)
            {
                <div class="pa-alert success mb-3">
                    <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="pa-alert danger mb-3">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
                </div>
            }

            <!-- Filtros -->
            <div class="pa-card p-3 mb-3">
                <div class="d-flex flex-wrap gap-3 align-items-center">
                    <div class="input-wrapper" style="max-width:350px;flex:1;">
                        <input type="text" id="buscador" class="pa-input"
                               placeholder="Buscar por vehículo, descripción..." />
                        <i class="fa-solid fa-magnifying-glass input-icon"></i>
                    </div>
                </div>
            </div>

            <!-- Tabla -->
            <div class="pa-card" style="overflow:hidden;">
                @if (!Model.Any())
                {
                    <div style="text-align:center;padding:4rem 2rem;">
                        <i class="fa-solid fa-receipt" style="font-size:3rem;color:var(--pa-border);display:block;margin-bottom:1rem;"></i>
                        <p style="color:var(--pa-muted);">No hay gastos registrados.</p>
                    </div>
                }
                else
                {
                    <div style="overflow-x:auto;">
                        <table class="pa-table" id="tablaGastos">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Vehículo</th>
                                    <th>Tipo</th>
                                    <th>Descripción</th>
                                    <th>Proveedor</th>
                                    <th>Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var g in Model)
                                {
                                    <tr>
                                        <td style="font-size:0.85rem;">@g.Fecha.ToString("dd/MM/yyyy")</td>
                                        <td style="font-weight:500;">@g.Vehiculo</td>
                                        <td>
                                            <span style="font-size:0.82rem;background:var(--pa-bg);padding:2px 8px;border-radius:4px;">
                                                @g.TipoGasto
                                            </span>
                                        </td>
                                        <td>@g.Descripcion</td>
                                        <td style="font-size:0.85rem;color:var(--pa-muted);">
                                            @g.Proveedor ?? "—"
                                        </td>
                                        <td style="font-weight:700;color:#ef4444;">
                                            - Gs. @g.Monto.ToString("N0")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @if (Model.Any())
            {
                <p style="font-size:0.8rem;color:var(--pa-muted);margin-top:0.75rem;text-align:right;">
                    <span id="totalVisible">@Model.Count</span> gasto(s)
                </p>
            }
        </div>
    </div>

    <style>
            .action-btn {
                width: 32px;
                height: 32px;
                border-radius: 7px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                font-size: 0.8rem;
                border: 1px solid var(--pa-border);
                background: transparent;
                cursor: pointer;
                transition: background var(--ease), border-color var(--ease);
                color: var(--pa-muted);
            }
    </style>

    <script>
            document.getElementById('buscador').addEventListener('input', function() {
                const q = this.value.toLowerCase();
                document.querySelectorAll('#tablaGastos tbody tr').forEach(tr => {
                    tr.style.display = !q || tr.textContent.toLowerCase().includes(q) ? '' : 'none';
                });
            });
    </script>
</body>
</html>