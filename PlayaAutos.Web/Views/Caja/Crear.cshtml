@model PlayaAutos.Web.Models.CrearMovimientoViewModel
@{
    Layout = null;
    ViewData["Title"] = "Nuevo Movimiento";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PlayaAutos — Nuevo Movimiento</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="pa-app">
    @await Html.PartialAsync("_Sidebar")
    <div class="pa-content">

        <div class="pa-page-header d-flex align-items-center gap-3">
            <a href="/Caja" class="action-btn" style="flex-shrink:0;" title="Volver">
                <i class="fa-solid fa-arrow-left"></i>
            </a>
            <div>
                <h4><i class="fa-solid fa-plus-circle me-2" style="color:var(--pa-accent);"></i>Nuevo Movimiento</h4>
                <p>Registrar ingreso o egreso manual</p>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="pa-alert danger mb-3">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                <strong>Corrija los errores antes de continuar.</strong>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="Crear" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-lg-8">
                    <div class="pa-card p-4">
                        <div class="section-title mb-3">
                            <i class="fa-solid fa-money-bill-wave me-1" style="color:var(--pa-accent);"></i>
                            Datos del Movimiento
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Fecha" class="pa-label">Fecha *</label>
                                <input asp-for="Fecha" type="date" class="pa-input" />
                                <span asp-validation-for="Fecha" class="val-msg"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="TipoMovimientoId" class="pa-label">Tipo *</label>
                                <select asp-for="TipoMovimientoId" class="pa-input" required>
                                    <option value="">— Seleccione —</option>
                                    @if (Model.TiposMovimiento != null && Model.TiposMovimiento.Any())
                                    {
                                        foreach (var tipo in Model.TiposMovimiento)
                                        {
                                            <option value="@tipo.Value">@tipo.Text</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="TipoMovimientoId" class="val-msg"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Monto" class="pa-label">Monto (Gs.) *</label>
                                <div class="input-wrapper">
                                    <input asp-for="Monto" type="number" class="pa-input" min="1" placeholder="0"
                                           style="padding-left:2.8rem !important;" />
                                    <span class="input-icon" style="font-size:0.75rem;font-weight:700;color:var(--pa-muted);">Gs.</span>
                                </div>
                                <span asp-validation-for="Monto" class="val-msg"></span>
                            </div>
                            <div class="col-md-12">
                                <label asp-for="Descripcion" class="pa-label">Descripción *</label>
                                <input asp-for="Descripcion" class="pa-input" placeholder="Ej: Pago de servicios" />
                                <span asp-validation-for="Descripcion" class="val-msg"></span>
                            </div>
                            <div class="col-md-12">
                                <label asp-for="Comentarios" class="pa-label">Comentarios</label>
                                <textarea asp-for="Comentarios" class="pa-input" rows="2" 
                                          placeholder="Observaciones adicionales..." style="resize:vertical;"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="pa-card p-4" style="position:sticky;top:1rem;">
                        <div class="section-title mb-3">
                            <i class="fa-solid fa-circle-info me-1" style="color:var(--pa-accent);"></i>
                            Información
                        </div>
                        <div style="font-size:0.85rem;color:var(--pa-muted);">
                            <p><i class="fa-solid fa-plus-circle me-2" style="color:#22c55e;"></i><strong>Ingreso (+):</strong> suma al saldo de caja.</p>
                            <p><i class="fa-solid fa-minus-circle me-2" style="color:#ef4444;"></i><strong>Egreso (-):</strong> resta del saldo de caja.</p>
                            <p style="margin:0;"><i class="fa-solid fa-robot me-2" style="color:var(--pa-info);"></i>Los movimientos por ventas y gastos de vehículos se generan automáticamente.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3 justify-content-end mt-4 pb-3">
                <a href="/Caja" class="btn-pa-ghost">
                    <i class="fa-solid fa-xmark"></i> Cancelar
                </a>
                <button type="submit" class="btn-pa-primary">
                    <i class="fa-solid fa-floppy-disk"></i> Registrar
                </button>
            </div>
        </form>
    </div>
</div>

<style>
    .val-msg { font-size: 0.78rem; color: #f87191; margin-top: 3px; display: block; }
    .action-btn {
        width: 34px; height: 34px;
        border-radius: 8px;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--pa-border);
        background: transparent;
        color: var(--pa-muted);
        text-decoration: none;
        transition: background var(--ease);
    }
    .action-btn:hover { background: rgba(255,255,255,0.06); color: var(--pa-text); }
</style>
</body>
</html>