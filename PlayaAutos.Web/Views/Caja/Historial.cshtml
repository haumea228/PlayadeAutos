@model List<PlayaAutos.Web.Models.CierreCajaViewModel>
@{
    Layout = null;
    ViewData["Title"] = "Historial de Cierres";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PlayaAutos — Historial de Caja</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="pa-app">
        @await Html.PartialAsync("_Sidebar")
        <div class="pa-content">

            <div class="pa-page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <a href="/Caja" class="action-btn" title="Volver">
                        <i class="fa-solid fa-arrow-left"></i>
                    </a>
                    <div>
                        <h4><i class="fa-solid fa-clock-rotate-left me-2" style="color:var(--pa-accent);"></i>Historial de Cierres</h4>
                        <p>Cierres de caja anteriores</p>
                    </div>
                </div>
                <a href="/Caja/ExportarExcel" class="btn-pa-ghost" title="Exportar todo a Excel">
                    <i class="fa-solid fa-file-excel me-1"></i> Exportar Todo
                </a>
            </div>

            @if (TempData["Exito"] != null)
            {
                <div class="pa-alert success mb-3">
                    <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
                </div>
            }

            <div class="pa-card" style="overflow:hidden;">
                @if (Model == null || !Model.Any())
                {
                    <div style="text-align:center;padding:4rem 2rem;">
                        <i class="fa-solid fa-clock-rotate-left" style="font-size:3rem;color:var(--pa-border);display:block;margin-bottom:1rem;"></i>
                        <p style="color:var(--pa-muted);">No hay cierres de caja registrados.</p>
                        <a href="/Caja" class="btn-pa-primary mt-3 d-inline-flex">
                            <i class="fa-solid fa-arrow-left me-1"></i> Volver a Caja
                        </a>
                    </div>
                }
                else
                {
                    <div style="overflow-x:auto;">
                        <table class="pa-table">
                            <thead>
                                <tr>
                                    <th>Lote</th>
                                    <th>Fecha Cierre</th>
                                    <th>Usuario</th>
                                    <th>Ingresos</th>
                                    <th>Egresos</th>
                                    <th>Saldo Neto</th>
                                    <th>Movs.</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model)
                                {
                                    <tr>
                                        <td style="font-weight:600;">#@c.CierreId</td>
                                        <td>@c.FechaCierre.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@c.Usuario</td>
                                        <td style="color:#22c55e;font-weight:600;">+ Gs. @c.TotalIngresos.ToString("N0")</td>
                                        <td style="color:#ef4444;font-weight:600;">- Gs. @c.TotalEgresos.ToString("N0")</td>
                                        <td style="font-weight:700;">Gs. @c.SaldoNeto.ToString("N0")</td>
                                        <td>@c.CantidadMovimientos</td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <a href="/Caja/DetalleCierre/@c.CierreId"
                                                   class="action-btn" title="Ver movimientos">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                                <a href="/Caja/ExportarCierreExcel/@c.CierreId"
                                                   class="action-btn excel" title="Descargar Excel">
                                                    <i class="fa-solid fa-file-excel"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <style>
            .action-btn {
                width: 34px;
                height: 34px;
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid var(--pa-border);
                background: transparent;
                color: var(--pa-muted);
                text-decoration: none;
                transition: background var(--ease);
            }

                .action-btn:hover {
                    background: rgba(255,255,255,0.06);
                    color: var(--pa-text);
                }

                .action-btn.excel:hover {
                    background: rgba(34,197,94,.12);
                    border-color: #22c55e;
                    color: #22c55e;
                }
    </style>
</body>
</html>