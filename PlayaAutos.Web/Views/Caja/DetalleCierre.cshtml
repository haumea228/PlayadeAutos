@model List<PlayaAutos.Web.Models.CajaListItem>
@{
    Layout = null;
    ViewData["Title"] = "Movimientos del Cierre #" + ViewBag.CierreId;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PlayaAutos — Cierre #@ViewBag.CierreId</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="pa-app">
        @await Html.PartialAsync("_Sidebar")
        <div class="pa-content">

            <div class="pa-page-header d-flex align-items-center gap-3">
                <a href="/Caja/Historial" class="action-btn" title="Volver">
                    <i class="fa-solid fa-arrow-left"></i>
                </a>
                <div>
                    <h4><i class="fa-solid fa-list-check me-2" style="color:var(--pa-accent);"></i>Movimientos del Cierre #@ViewBag.CierreId</h4>
                    <p>Detalle de movimientos cerrados</p>
                </div>
            </div>

            <div class="pa-card" style="overflow:hidden;">
                @if (Model == null || !Model.Any())
                {
                    <div style="text-align:center;padding:3rem 2rem;">
                        <p style="color:var(--pa-muted);">No hay movimientos en este cierre.</p>
                    </div>
                }
                else
                {
                    <div style="overflow-x:auto;">
                        <table class="pa-table">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Tipo</th>
                                    <th>Descripción</th>
                                    <th>Referencia</th>
                                    <th>Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var m in Model)
                                {
                                    <tr>
                                        <td>@m.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <span class="tipo-badge" style="background:@(m.Signo == "+" ? "rgba(34,197,94,.12)" : "rgba(239,68,68,.12)");color:@(m.Signo == "+" ? "#22c55e" : "#ef4444");">
                                                @m.TipoMovimiento
                                            </span>
                                        </td>
                                        <td>@m.Descripcion</td>
                                        <td style="font-size:0.82rem;color:var(--pa-muted);">@(m.Referencia ?? "—")</td>
                                        <td style="font-weight:700;color:@(m.Signo == "+" ? "#22c55e" : "#ef4444");">
                                            @(m.Signo == "+" ? "+ " : "- ")Gs. @m.Monto.ToString("N0")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
    <style>
            .action-btn {
                width: 34px;
                height: 34px;
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid var(--pa-border);
                background: transparent;
                color: var(--pa-muted);
                text-decoration: none;
                transition: background var(--ease);
            }

                .action-btn:hover {
                    background: rgba(255,255,255,0.06);
                    color: var(--pa-text);
                }

            .tipo-badge {
                display: inline-block;
                padding: 0.2em 0.65em;
                font-size: 0.75rem;
                font-weight: 600;
                border-radius: 50px;
                white-space: nowrap;
            }
    </style>
</body>
</html>