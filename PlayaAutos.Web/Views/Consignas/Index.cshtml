@model List<PlayaAutos.Web.Models.ConsignaListItem>
@{
    Layout = null;
    ViewData["Title"] = "Consignas";
    var filtroActual = (string)(ViewBag.FiltroActual ?? "todas");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PlayaAutos — Consignas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="pa-app">

    @await Html.PartialAsync("_Sidebar")

    <div class="pa-content">

        <div class="pa-page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h4><i class="fa-solid fa-file-contract me-2" style="color:var(--pa-accent);"></i>Consignas</h4>
                <p>Contratos de consignación activos e históricos</p>
            </div>
            <a href="/Consignas/Crear" class="btn-pa-primary">
                <i class="fa-solid fa-plus"></i> Nueva Consigna
            </a>
        </div>

        @if (TempData["Exito"] != null)
        {
            <div class="pa-alert success mb-3">
                <i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="pa-alert danger mb-3">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
            </div>
        }

        <div class="pa-card mb-3">
            <div class="pa-card-body" style="padding:0.75rem 1.25rem;">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex gap-2 flex-wrap">
                        <a href="/Consignas?filtro=todas"    class="filtro-btn @(filtroActual == "todas"   ? "active" : "")">Todas</a>
                        <a href="/Consignas?filtro=vigente"  class="filtro-btn @(filtroActual == "vigente" ? "active" : "")">Vigentes</a>
                        <a href="/Consignas?filtro=vencido"  class="filtro-btn @(filtroActual == "vencido" ? "active" : "")">Vencidas</a>
                        <a href="/Consignas?filtro=anulado"  class="filtro-btn @(filtroActual == "anulado" ? "active" : "")">Anuladas</a>
                    </div>
                    <input type="text" id="buscador" class="pa-input" placeholder="Buscar consignante, vehículo…" style="max-width:260px;" />
                </div>
            </div>
        </div>

        <div class="pa-card">
            <div class="pa-card-body" style="padding:0;">
                <div class="table-responsive">
                    <table class="pa-table">
                        <thead>
                            <tr>
                                <th>Nº Contrato</th>
                                <th>Consignante</th>
                                <th>Vehículo</th>
                                <th style="text-align:right;">Precio base</th>
                                <th style="text-align:center;">Comisión</th>
                                <th>Inicio</th>
                                <th>Vencimiento</th>
                                <th style="text-align:center;">Estado</th>
                                <th style="text-align:center;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="9" style="text-align:center;padding:3rem;color:var(--pa-muted);">
                                        <i class="fa-solid fa-file-contract" style="font-size:2rem;display:block;margin-bottom:0.75rem;opacity:0.3;"></i>
                                        No hay consignas registradas
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var c in Model)
                                {
                                    var estadoClass = c.Estado switch
                                    {
                                        "Vigente"  => "badge-success",
                                        "Anulado"  => "badge-danger",
                                        "Vencido"  => "badge-secondary",
                                        _          => "badge-secondary"
                                    };
                                    var diasRestantes = (c.FechaFin - DateTime.Today).Days;
                                    <tr data-row>
                                        <td>
                                            <span style="font-family:monospace;font-weight:600;font-size:0.85rem;">@c.NumeroContrato</span>
                                        </td>
                                        <td>
                                            <div style="font-weight:600;">@c.Consignante</div>
                                            @if (!string.IsNullOrEmpty(c.ConsignanteCI))
                                            {
                                                <div style="font-size:0.78rem;color:var(--pa-muted);">@c.ConsignanteCI</div>
                                            }
                                        </td>
                                        <td>@c.Vehiculo</td>
                                        <td style="text-align:right;font-weight:600;">Gs. @c.PrecioCliente.ToString("N0")</td>
                                        <td style="text-align:center;">@c.PorcentajeComision.ToString("N1")%</td>
                                        <td>@c.FechaInicio.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @c.FechaFin.ToString("dd/MM/yyyy")
                                            @if (c.Estado == "Vigente" && diasRestantes <= 15 && diasRestantes >= 0)
                                            {
                                                <div style="font-size:0.75rem;color:#f59e0b;font-weight:600;">
                                                    <i class="fa-solid fa-clock"></i> @diasRestantes d. restantes
                                                </div>
                                            }
                                        </td>
                                        <td style="text-align:center;">
                                            <span class="pa-badge @estadoClass">@c.Estado</span>
                                        </td>
                                        <td style="text-align:center;">
                                            <div style="display:flex;gap:0.4rem;justify-content:center;align-items:center;">
                                                <a href="/Consignas/Contrato/@c.ContratoId"
                                                   class="action-btn pdf" title="Ver / descargar contrato">
                                                    <i class="fa-solid fa-file-pdf"></i>
                                                </a>
                                                @if (c.Estado == "Vigente")
                                                {
                                                    <form asp-action="Anular" method="post" style="display:contents;"
                                                          onsubmit="return confirm('¿Anular la consigna @c.NumeroContrato?\nEl vehículo saldrá del catálogo.');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@c.ContratoId" />
                                                        <button type="submit" class="action-btn delete" title="Anular consigna">
                                                            <i class="fa-solid fa-ban"></i>
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <span style="color:var(--pa-muted);font-size:0.75rem;min-width:32px;text-align:center;">—</span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div id="footerCount" style="padding:0.75rem 1.25rem;font-size:0.82rem;color:var(--pa-muted);text-align:right;border-top:1px solid var(--pa-border);">
                    <span id="totalVisible">@Model.Count</span> consigna(s)
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    document.getElementById('buscador').addEventListener('input', function () {
        const q = this.value.toLowerCase();
        const rows = document.querySelectorAll('tbody tr[data-row]');
        let visible = 0;
        rows.forEach(function (tr) {
            const match = tr.textContent.toLowerCase().includes(q);
            tr.style.display = match ? '' : 'none';
            if (match) visible++;
        });
        document.getElementById('totalVisible').textContent = visible;
        document.getElementById('footerCount').style.display = visible === 0 ? 'none' : '';
    });
</script>
<style>
    .filtro-btn {
        display: inline-flex; align-items: center; padding: 0.35rem 0.85rem;
        border-radius: 999px; font-size: 0.82rem; font-weight: 500;
        border: 1px solid var(--pa-border); background: transparent;
        color: var(--pa-muted); text-decoration: none;
        transition: background var(--ease), border-color var(--ease), color var(--ease);
    }
    .filtro-btn:hover { background: var(--pa-surface-2); color: var(--pa-text); }
    .filtro-btn.active { background: var(--pa-accent); border-color: var(--pa-accent); color: #fff; }
    .action-btn {
        width: 32px; height: 32px;
        border-radius: 7px;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 0.82rem;
        border: 1px solid var(--pa-border);
        background: transparent;
        cursor: pointer;
        text-decoration: none;
        transition: background var(--ease), border-color var(--ease), color var(--ease);
        color: var(--pa-muted);
    }
    .action-btn.pdf  { color: #6366f1; }
    .action-btn.pdf:hover  { background: rgba(99,102,241,.12); border-color: #6366f1; }
    .action-btn.delete { color: #ef4444; }
    .action-btn.delete:hover { background: rgba(239,68,68,.12); border-color: #ef4444; }
</style>
</body>
</html>
