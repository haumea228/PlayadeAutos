@model List<PlayaAutos.Web.Models.VentaListItem>
@{
    Layout = null;
    ViewData["Title"] = "Ventas Pendientes";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PlayaAutos — Ventas Pendientes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="pa-app">
        @await Html.PartialAsync("_Sidebar")
        <div class="pa-content">

            <div class="pa-page-header d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <h4><i class="fa-solid fa-clock me-2" style="color:#ca8a04;"></i>Ventas Pendientes</h4>
                    <p>Ventas creadas por vendedores que requieren finalización</p>
                </div>
            </div>

            @if (TempData["Exito"] != null)
            {
                <div class="pa-alert success mb-3"><i class="fa-solid fa-circle-check me-2"></i>@TempData["Exito"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="pa-alert danger mb-3"><i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]</div>
            }

            <div class="pa-card" style="overflow:hidden;">
                @if (!Model.Any())
                {
                    <div style="text-align:center;padding:4rem 2rem;">
                        <i class="fa-solid fa-check-circle" style="font-size:3rem;color:#22c55e;display:block;margin-bottom:1rem;"></i>
                        <p style="color:var(--pa-muted);">No hay ventas pendientes de finalización.</p>
                    </div>
                }
                else
                {
                    <div style="overflow-x:auto;">
                        <table class="pa-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Cliente</th>
                                    <th>Vehículo</th>
                                    <th>Vendedor</th>
                                    <th>Tipo</th>
                                    <th>Fecha</th>
                                    <th>Monto total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var v in Model)
                                {
                                    <tr>
                                        <td style="font-family:monospace;font-size:0.8rem;">#@v.VentaId</td>
                                        <td style="font-weight:600;">@v.Cliente</td>
                                        <td style="font-size:0.88rem;">@v.Vehiculo</td>
                                        <td style="font-size:0.85rem;color:var(--pa-muted);">@v.Vendedor</td>
                                        <td>@v.TipoVenta</td>
                                        <td>@v.FechaVenta.ToString("dd/MM/yyyy")</td>
                                        <td style="font-weight:600;">Gs. @v.MontoTotal.ToString("N0")</td>
                                        <td>
                                            <form method="post" action="/Ventas/Finalizar/@v.VentaId" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn-pa-primary" style="background:#22c55e;border-color:#22c55e;font-size:0.82rem;padding:0.4rem 0.8rem;"
                                                        onclick="return confirm('¿Finalizar la venta #@v.VentaId? Se generará factura, nota de crédito y movimiento de caja.')">
                                                    <i class="fa-solid fa-check me-1"></i> Finalizar
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</body>
</html>